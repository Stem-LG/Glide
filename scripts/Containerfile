FROM quay.io/fedora/fedora:44
RUN dnf install -y --setopt=install_weak_deps=False gcc pkgconf-pkg-config gtk4-devel libadwaita-devel openssl-devel file squashfs-tools python3 python3-aiohttp git curl && dnf clean all
WORKDIR /work
# Mount a Rust toolchain or install one from rustup, then run scripts/build.sh.
# The current development container mounts CARGO_HOME=/opt/cargo and
# RUSTUP_HOME=/opt/rustup, with /opt/cargo/bin added to PATH.
